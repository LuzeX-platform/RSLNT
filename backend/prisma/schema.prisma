// LuzeX RSLNT — datamodel.
// Meerdere mensen, elk met een eigen account: alle trainings- en gezondheidsdata hangt aan een
// Gebruiker (gebruikerId) en elke query filtert daarop. Verwijder je je account, dan gaat alles mee.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gebruiker {
  id                    String    @id @default(cuid())
  email                 String    @unique
  naam                  String
  wachtwoordHash        String
  /// lid | admin. Admin is het account uit de seed (de eigenaar), nooit via registratie.
  rol                   String    @default("lid")
  emailBevestigdOp      DateTime?
  /// Alleen de sha256-hash van een token staat hier; het ruwe token staat alleen in de mail.
  bevestigTokenHash     String?   @unique
  resetTokenHash        String?   @unique
  resetTokenVerlooptOp  DateTime?
  /// Uitdrukkelijke toestemming voor gezondheidsgegevens (AVG art. 9), met de versie van de privacyverklaring.
  toestemmingOp         DateTime?
  privacyVersie         String?
  /// Gaat omhoog bij een nieuw wachtwoord: oudere sessies (op andere apparaten) vervallen dan.
  sessieVersie          Int       @default(0)
  mislukteInlogpogingen Int       @default(0)
  vergrendeldTot        DateTime?
  /// Pro-status komt alléén van de Stripe-webhook (checkout/subscription-events), van
  /// kruisproductCron.ts/de claimroute (via proBron), of van de eigenaar in het beheer
  /// (PATCH /api/admin/gebruikers/:id/pro) — nooit van een route die een lid zelf aanroept.
  pro                   Boolean   @default(false)
  /// "accrd" | "scrnn" | "handmatig" | null. "accrd"/"scrnn" als Pro van een actief account
  /// daar kwam (zie luzexKruisproduct.ts), "handmatig" als de eigenaar het cadeau gaf in het
  /// beheer, null bij een betaald Stripe-abonnement. Zo kan de cron een
  /// vervallen kruisproduct-Pro intrekken zonder ooit een betalend account te raken.
  proBron               String?
  /// Kvk-nummer waarmee deze gebruiker gratis Pro claimde bij ACCRD (zie routes/kruisproduct.ts).
  /// Alleen gezet als proBron "accrd" is; bewaard zodat kruisproductCron.ts dagelijks zonder
  /// nieuwe invoer bij de gebruiker opnieuw bij ACCRD kan navragen. @unique: één kvk-nummer
  /// claimt bij ACCRD precies één RSLNT-account, net zoals ACCRD het zelf afdwingt.
  kruisproductKvkNummer String?   @unique @map("kruisproduct_kvk_nummer")
  stripeKlantId         String?   @unique @map("stripe_klant_id")
  stripeAbonnementId    String?   @unique @map("stripe_abonnement_id")
  /// Wanneer iemand de rondleiding door de app heeft afgerond of overgeslagen. Op de server en
  /// niet in localStorage: anders krijg je hem op je telefoon na de laptop gewoon nog een keer.
  rondleidingGezienOp   DateTime? @map("rondleiding_gezien_op")
  /// Geheime link naar je trainingsagenda (iCal, voor Apple Agenda e.d.). Alleen de sha256-hash;
  /// het ruwe token staat alleen in de link die je zelf kopieert. Opnieuw maken = oude link dood.
  agendaTokenHash       String?   @unique @map("agenda_token_hash")
  aangemaaktOp          DateTime  @default(now())
  bijgewerktOp          DateTime  @default(now()) @updatedAt

  programmas     Programma[]
  oefeningen     Oefening[]
  trainingen     Training[]
  gewichten      Lichaamsgewicht[]
  metingen       Lichaamsmeting[]
  herstelchecks  Herstelcheck[]
  profiel        Profiel?
  voorkeuren     Voorkeuren?
  duurtrainingen Duurtraining[]
  pijnnotities   Pijnnotitie[]
  deellinks      Deellink[]
  planning       Planning[]
  duurschema     Duurschema?
  samenGastheer  SamenSessie[]
  samenMee       SamenDeelnemer[]
}

/// Je duursportschema (duurschema.ts): de keuzes, je dagen en wanneer het begon. De sessies zelf
/// worden elke keer uit deze keuzes berekend, net als het gewichtsvoorstel; niets dubbel bewaard.
model Duurschema {
  gebruikerId  String   @id
  /// hardlopen | fietsen | zwemmen
  sport        String
  /// conditie | afstand | afvallen
  doel         String
  /// km (hardlopen, fietsen) of meters (zwemmen); alleen bij doel "afstand"
  afstand      Float?
  /// beginner | gevorderd
  niveau       String
  dagenPerWeek Int
  /// 1 = maandag … 7 = zondag, evenveel als dagenPerWeek
  dagen        Int[]
  /// "HH:MM", voor de agenda
  tijd         String   @default("07:30")
  /// Maandag van week 1
  startdatum   DateTime @db.Date
  aangemaaktOp DateTime @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
}

/// De weekplanner: welke training op welke dag (en hoe laat). Eén training per dag. Zonder
/// planning voor het actieve programma geldt de rotatie A → B → C, los van de weekdag.
model Planning {
  gebruikerId String
  /// 1 = maandag … 7 = zondag
  weekdag     Int
  schemaId    String
  /// "HH:MM", Nederlandse tijd. Voor de agenda.
  tijd        String @default("18:00")

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schema    Schema    @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, weekdag])
  @@index([schemaId])
}

model Oefening {
  id               String   @id @default(cuid())
  gebruikerId      String
  /// Vaste sleutel, gelijk aan exercise_id in een programma-JSON (bijv. trap_bar_deadlift).
  sleutel          String
  naam             String
  /// dumbbell | barbell | trap_bar | kabel | machine | lichaamsgewicht | kettlebell | band | overig
  materiaal        String
  /// Kleinste gewichtsstap in kg (bij dumbbells: per dumbbell). 0 = zonder gewicht.
  gewichtsstap     Float
  /// Reps tellen per kant/been (dead bug, Bulgarian split squat).
  perKant          Boolean  @default(false)
  spierenPrimair   String[] @default([])
  spierenSecundair String[] @default([])
  /// compound | isolation
  mechaniek        String?
  unilateraal      Boolean  @default(false)
  /// Belast de knie. Gebruikt door het schema op maat bij de klacht "knie" (hoogstens één per
  /// training). De pijnregel geldt voor elke oefening waar je pijn meldt, los hiervan.
  knieGevoelig     Boolean  @default(false)
  /// Sleutels van oefeningen waarmee je deze mag wisselen.
  alternatieven    String[] @default([])
  /// Id in de oefeningenbibliotheek (data/bibliotheek.json, Free Exercise DB): uitleg en foto's.
  bibliotheekId    String?
  aangemaaktOp     DateTime @default(now())

  gebruiker      Gebruiker          @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schemaRegels   SchemaOefening[]
  trainingRegels TrainingOefening[]

  @@unique([gebruikerId, sleutel])
  @@unique([gebruikerId, naam])
}

/// Een trainingsprogramma (bijv. Benen / Push / Pull), meestal geïmporteerd uit een JSON-bestand.
/// Er is er altijd hooguit één actief.
model Programma {
  id                String    @id @default(cuid())
  gebruikerId       String
  /// program.id uit de JSON, bijv. split_legs_push_pull_v1
  sleutel           String
  naam              String
  actief            Boolean   @default(false)
  /// Begin van de introfase en van de deloadcyclus: de dag van activeren.
  startdatum        DateTime  @db.Date
  sessiesPerWeekMin Int       @default(2)
  sessiesPerWeekMax Int       @default(3)
  minRustdagen      Int       @default(0)
  opwarmen          String    @default("")
  introWeken        Int       @default(0)
  introSets         Int?
  introRir          Int?
  /// Elke zoveelste week een deload; null = nooit automatisch.
  deloadElkeWeken   Int?
  deloadSetFactor   Float     @default(0.5)
  /// Handmatige deload ("nu deloaden") tot en met deze dag.
  deloadTot         DateTime? @db.Date
  /// Het geïmporteerde bestand, ongewijzigd: voor export en voor latere fases (doel, regels).
  bron              Json?
  /// Pro: een blokplan (periodisering.ts): { doel, start, blokken: [{ soort, weken }] }. Leeg =
  /// geen blokken. Een training legt haar blok vast (Training.blok), dus stoppen of een nieuw
  /// plan herschrijft de geschiedenis niet.
  periodisering     Json?
  aangemaaktOp      DateTime  @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schemas   Schema[]

  @@unique([gebruikerId, sleutel])
  @@index([gebruikerId, actief])
}

model Schema {
  /// "A"/"B" bij het eerste programma, daarna een cuid.
  id          String   @id @default(cuid())
  programmaId String
  /// Letter in de rotatie: A, B, C …
  code        String
  naam        String
  volgorde    Int
  minuten     Int?
  focus       String[] @default([])
  /// false = niet meer in de rotatie (bij een nieuwe versie van het programma weggevallen).
  inRotatie   Boolean  @default(true)

  programma  Programma        @relation(fields: [programmaId], references: [id], onDelete: Cascade)
  oefeningen SchemaOefening[]
  trainingen Training[]
  planning   Planning[]

  @@unique([programmaId, code])
}

model SchemaOefening {
  id            String  @id @default(cuid())
  schemaId      String
  oefeningId    String
  volgorde      Int
  aantalSets    Int
  /// Zoveel sets moeten er minstens gelogd zijn voordat de oefening omhoog mag (bij "2–3 sets": 2).
  minSets       Int
  repsMin       Int
  repsMax       Int
  /// Oefeningen met dezelfde letter worden als superset getoond.
  supersetGroep String?
  rustSeconden  Int?
  doelRir       Int?
  cue           String  @default("")
  /// Pro: dubbel | lineair | rir | vast (zie progressie.ts). Zonder Pro geldt altijd "dubbel".
  progressie    String  @default("dubbel")
  /// Pro: dropset | myoreps | restpauze na de laatste set, of null.
  techniek      String?

  schema   Schema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  oefening Oefening @relation(fields: [oefeningId], references: [id])

  @@index([schemaId, volgorde])
}

model Training {
  id           String    @id @default(cuid())
  gebruikerId  String
  schemaId     String
  datum        DateTime  @default(now())
  notitie      String    @default("")
  /// bezig | afgerond
  status       String    @default("bezig")
  /// normaal | intro | deload | licht — vastgelegd bij het starten. "licht" is de lichte dag
  /// (Pro): één set minder en een rep meer over, alleen voor deze training.
  fase         String    @default("normaal")
  /// Pro: het blok uit het blokplan (opbouw, volume, intensivering, piek), vastgelegd bij het starten.
  blok         String?
  /// Week van het programma (1 = eerste week), vastgelegd bij het starten.
  week         Int?
  afgerondOp   DateTime?
  aangemaaktOp DateTime  @default(now())

  gebruiker  Gebruiker          @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schema     Schema             @relation(fields: [schemaId], references: [id])
  oefeningen TrainingOefening[]

  @@index([gebruikerId, datum])
}

/// Momentopname van het schema bij het starten van een training: een latere schemawijziging
/// herschrijft je geschiedenis niet.
model TrainingOefening {
  id                  String  @id @default(cuid())
  trainingId          String
  oefeningId          String
  volgorde            Int
  aantalSets          Int
  minSets             Int
  repsMin             Int
  repsMax             Int
  supersetGroep       String?
  rustSeconden        Int?
  doelRir             Int?
  cue                 String  @default("")
  /// Gezet als je deze oefening voor een alternatief hebt gewisseld: de oefening uit het schema.
  origineleOefeningId String?
  /// Momentopname van de progressieregel en techniek van die dag ("dubbel" zonder Pro).
  progressie          String  @default("dubbel")
  techniek            String?

  training Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  oefening Oefening      @relation(fields: [oefeningId], references: [id])
  sets     TrainingSet[]

  @@index([oefeningId])
}

model TrainingSet {
  id                 String   @id @default(cuid())
  trainingOefeningId String
  nummer             Int
  /// null bij lichaamsgewicht
  gewicht            Float?
  reps               Int
  /// 0–4, optioneel
  rir                Int?
  /// Pijn tijdens deze set, 0–10, optioneel. Leeg betekent onbekend, niet 0.
  pijn               Int?
  /// Waar: knie, schouder, elleboog, pols, onderrug, heup, enkel, anders (pijn.ts). Leeg: niet gezegd.
  pijnPlek           String?
  /// normaal | drop | myo | restpauze. Een techniekset (Pro) komt na de gewone sets, telt voor de
  /// helft mee in je volume en niet mee voor je progressie of je geschatte 1RM.
  soort              String   @default("normaal")
  opgeslagenOp       DateTime @default(now()) @updatedAt

  trainingOefening TrainingOefening @relation(fields: [trainingOefeningId], references: [id], onDelete: Cascade)

  @@unique([trainingOefeningId, nummer])
}

model Lichaamsgewicht {
  gebruikerId  String
  datum        DateTime @db.Date
  gewicht      Float
  opgeslagenOp DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}

/// Jouw gegevens voor de berekeningen in het gezondheidsmenu. Eén rij per account.
model Profiel {
  gebruikerId   String    @id
  geboortedatum DateTime? @db.Date
  /// man | vrouw — nodig voor de BMR- en vetpercentageformules.
  geslacht      String?
  lengteCm      Float?
  /// sedentair | licht | matig | zwaar | zeer_zwaar
  activiteit    String    @default("licht")
  /// Leeg: het doel uit het actieve programma.
  doelgewicht   Float?
  /// Gewenst tempo in kg per week; leeg: uit het actieve programma.
  tempoMin      Float?
  tempoMax      Float?
  /// Wanneer je je doelgewicht wilt halen; het personalisatiemenu toetst of dat haalbaar is.
  streefdatum   DateTime? @db.Date
  bijgewerktOp  DateTime  @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
}

/// Wat je in het personalisatiemenu invult. Eén rij per account, net als Profiel.
model Voorkeuren {
  gebruikerId        String   @id
  /// spiermassa | kracht | vetverlies | fit
  doel               String   @default("spiermassa")
  /// beginner | gevorderd | ervaren
  ervaring           String   @default("gevorderd")
  dagenPerWeek       Int      @default(3)
  minutenPerTraining Int      @default(60)
  /// Zie MATERIAAL_KEUZES in generator.ts. Lichaamsgewicht kan altijd.
  materiaal          String[] @default(["dumbbell", "barbell", "trap_bar", "kabel", "machine", "stang"])
  /// knie | schouder | rug
  blessures          String[] @default([])
  /// Bibliotheek-id's.
  favorieten         String[] @default([])
  uitgesloten        String[] @default([])
  /// Spiersleutels die extra aandacht krijgen.
  focus              String[] @default([])
  bijgewerktOp       DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
}

/// Omtrekmaten en (gemeten) vetpercentage, per dag. Gewicht staat in Lichaamsgewicht.
model Lichaamsmeting {
  gebruikerId   String
  datum         DateTime @db.Date
  /// Zelf gemeten (scan, weegschaal); leeg = schatten uit taille en nek.
  vetpercentage Float?
  tailleCm      Float?
  nekCm         Float?
  heupCm        Float?
  armCm         Float?
  borstCm       Float?
  dijCm         Float?
  opgeslagenOp  DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}

/// Herstelcheck vóór de training, schaal 1–5. Geen totaalscore: de signalen staan los.
model Herstelcheck {
  gebruikerId  String
  datum        DateTime @db.Date
  /// 1 = slecht, 5 = top
  slaap        Int
  /// 1 = geen, 5 = veel
  spierpijn    Int
  /// 1 = leeg, 5 = vol energie
  energie      Int
  /// Pijntjes of een blessure: 1 = geen, 5 = veel
  pijn         Int
  /// Waar (pijn.ts), optioneel.
  pijnPlekken  String[] @default([])
  opgeslagenOp DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}

/// Pro cadeau voor een e-mailadres dat (nog) geen bevestigd account heeft. Wordt ingewisseld op het
/// moment dat iemand dat adres bevestigt, niet bij het aanmelden: pas dan is bewezen dat het adres
/// van die persoon is, en een onbevestigd account wordt na een week opgeruimd (zie auth.ts). Nooit
/// verwijderd: ingewisseld of ingetrokken wordt een datum, zodat terug te zien is wat er gebeurde.
model ProUitnodiging {
  id            String    @id @default(cuid())
  email         String    @unique
  aangemaaktOp  DateTime  @default(now())
  ingewisseldOp DateTime?
  ingetrokkenOp DateTime?
}

/// Pro: een duurtraining (hardlopen, fietsen …) naast je krachttraining, voor het hybride advies.
model Duurtraining {
  id           String   @id @default(cuid())
  gebruikerId  String
  datum        DateTime @db.Date
  /// hardlopen | fietsen | zwemmen | roeien | wandelen | anders
  soort        String
  minuten      Int
  /// In hele meters; leeg mag.
  afstandMeter Int?
  /// rustig | duur | tempo | interval
  intensiteit  String
  notitie      String   @default("")
  aangemaaktOp DateTime @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@index([gebruikerId, datum])
}

/// Pro: een notitie in het pijnlogboek, naast de pijn die je per set en in de herstelcheck geeft.
/// Niet verwijderen maar op "hersteld" zetten: zo blijft het verloop voor je fysio te zien.
model Pijnnotitie {
  id           String    @id @default(cuid())
  gebruikerId  String
  datum        DateTime  @db.Date
  /// pijn.ts
  plek         String
  /// 0–10
  ernst        Int
  notitie      String    @default("")
  /// actief | hersteld
  status       String    @default("actief")
  herstelOp    DateTime? @db.Date
  aangemaaktOp DateTime  @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@index([gebruikerId, datum])
}

/// Pro: een leeslink voor je trainer of fysio. Alleen de sha256-hash van het token staat hier.
/// Intrekken zet een datum; de rij blijft, zodat je ziet wie wanneer toegang had.
model Deellink {
  id              String    @id @default(cuid())
  gebruikerId     String
  tokenHash       String    @unique
  /// Voor wie, bijvoorbeeld "Fysio Sanne". Alleen voor jezelf.
  naam            String
  /// trainingen | kracht | pijn | duur
  onderdelen      String[]
  verlooptOp      DateTime
  ingetrokkenOp   DateTime?
  laatstBekekenOp DateTime?
  aangemaaktOp    DateTime  @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@index([gebruikerId])
}

/// Samen trainen: één keer samen dezelfde training. Wie uitnodigt kiest een training uit het eigen
/// schema; de oefeningen staan hier als momentopname, zodat meedoen ook werkt als het schema later
/// verandert. Na 12 uur kan niemand meer meedoen; wat gelogd is blijft gewoon in ieders account.
model SamenSessie {
  id           String   @id @default(cuid())
  /// Korte code om te delen (6 tekens, zonder lettertjes die op elkaar lijken).
  code         String   @unique
  gastheerId   String
  /// Het schema van wie uitnodigt; die traint daar gewoon mee.
  schemaId     String
  naam         String
  minuten      Int?
  /// [{ oefeningId, volgorde, aantalSets, minSets, repsMin, repsMax, supersetGroep, rustSeconden, doelRir, cue }]
  oefeningen   Json
  geldigTot    DateTime
  aangemaaktOp DateTime @default(now())

  gastheer   Gebruiker        @relation(fields: [gastheerId], references: [id], onDelete: Cascade)
  deelnemers SamenDeelnemer[]

  @@index([gastheerId])
}

model SamenDeelnemer {
  id           String   @id @default(cuid())
  sessieId     String
  gebruikerId  String
  /// De training die deze deelnemer startte, of null (nog niet begonnen).
  trainingId   String?
  aangemaaktOp DateTime @default(now())

  sessie    SamenSessie @relation(fields: [sessieId], references: [id], onDelete: Cascade)
  gebruiker Gebruiker   @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@unique([sessieId, gebruikerId])
  @@index([gebruikerId])
  @@index([trainingId])
}
