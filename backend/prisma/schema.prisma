// LuzeX RSLNT — datamodel.
// Meerdere mensen, elk met een eigen account: alle trainings- en gezondheidsdata hangt aan een
// Gebruiker (gebruikerId) en elke query filtert daarop. Verwijder je je account, dan gaat alles mee.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gebruiker {
  id                    String    @id @default(cuid())
  email                 String    @unique
  naam                  String
  wachtwoordHash        String
  /// lid | admin. Admin is het account uit de seed (de eigenaar), nooit via registratie.
  rol                   String    @default("lid")
  emailBevestigdOp      DateTime?
  /// Alleen de sha256-hash van een token staat hier; het ruwe token staat alleen in de mail.
  bevestigTokenHash     String?   @unique
  resetTokenHash        String?   @unique
  resetTokenVerlooptOp  DateTime?
  /// Uitdrukkelijke toestemming voor gezondheidsgegevens (AVG art. 9), met de versie van de privacyverklaring.
  toestemmingOp         DateTime?
  privacyVersie         String?
  /// Gaat omhoog bij een nieuw wachtwoord: oudere sessies (op andere apparaten) vervallen dan.
  sessieVersie          Int       @default(0)
  mislukteInlogpogingen Int       @default(0)
  vergrendeldTot        DateTime?
  /// Pro-status komt alléén van de Stripe-webhook (checkout/subscription-events), nooit
  /// rechtstreeks gezet door een route — zo kan een client 'm niet zelf aanzetten.
  pro                   Boolean   @default(false)
  stripeKlantId         String?   @unique @map("stripe_klant_id")
  stripeAbonnementId    String?   @unique @map("stripe_abonnement_id")
  aangemaaktOp          DateTime  @default(now())
  bijgewerktOp          DateTime  @default(now()) @updatedAt

  programmas    Programma[]
  oefeningen    Oefening[]
  trainingen    Training[]
  gewichten     Lichaamsgewicht[]
  metingen      Lichaamsmeting[]
  herstelchecks Herstelcheck[]
  profiel       Profiel?
  voorkeuren    Voorkeuren?
}

model Oefening {
  id               String   @id @default(cuid())
  gebruikerId      String
  /// Vaste sleutel, gelijk aan exercise_id in een programma-JSON (bijv. trap_bar_deadlift).
  sleutel          String
  naam             String
  /// dumbbell | barbell | trap_bar | kabel | machine | lichaamsgewicht | kettlebell | band | overig
  materiaal        String
  /// Kleinste gewichtsstap in kg (bij dumbbells: per dumbbell). 0 = zonder gewicht.
  gewichtsstap     Float
  /// Reps tellen per kant/been (dead bug, Bulgarian split squat).
  perKant          Boolean  @default(false)
  spierenPrimair   String[] @default([])
  spierenSecundair String[] @default([])
  /// compound | isolation
  mechaniek        String?
  unilateraal      Boolean  @default(false)
  /// Alleen hierop geldt de kniepijnregel.
  knieGevoelig     Boolean  @default(false)
  /// Sleutels van oefeningen waarmee je deze mag wisselen.
  alternatieven    String[] @default([])
  /// Id in de oefeningenbibliotheek (data/bibliotheek.json, Free Exercise DB): uitleg en foto's.
  bibliotheekId    String?
  aangemaaktOp     DateTime @default(now())

  gebruiker      Gebruiker          @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schemaRegels   SchemaOefening[]
  trainingRegels TrainingOefening[]

  @@unique([gebruikerId, sleutel])
  @@unique([gebruikerId, naam])
}

/// Een trainingsprogramma (bijv. Benen / Push / Pull), meestal geïmporteerd uit een JSON-bestand.
/// Er is er altijd hooguit één actief.
model Programma {
  id                String    @id @default(cuid())
  gebruikerId       String
  /// program.id uit de JSON, bijv. split_legs_push_pull_v1
  sleutel           String
  naam              String
  actief            Boolean   @default(false)
  /// Begin van de introfase en van de deloadcyclus: de dag van activeren.
  startdatum        DateTime  @db.Date
  sessiesPerWeekMin Int       @default(2)
  sessiesPerWeekMax Int       @default(3)
  minRustdagen      Int       @default(0)
  opwarmen          String    @default("")
  introWeken        Int       @default(0)
  introSets         Int?
  introRir          Int?
  /// Elke zoveelste week een deload; null = nooit automatisch.
  deloadElkeWeken   Int?
  deloadSetFactor   Float     @default(0.5)
  /// Handmatige deload ("nu deloaden") tot en met deze dag.
  deloadTot         DateTime? @db.Date
  /// Het geïmporteerde bestand, ongewijzigd: voor export en voor latere fases (doel, regels).
  bron              Json?
  aangemaaktOp      DateTime  @default(now())

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schemas   Schema[]

  @@unique([gebruikerId, sleutel])
  @@index([gebruikerId, actief])
}

model Schema {
  /// "A"/"B" bij het eerste programma, daarna een cuid.
  id          String   @id @default(cuid())
  programmaId String
  /// Letter in de rotatie: A, B, C …
  code        String
  naam        String
  volgorde    Int
  minuten     Int?
  focus       String[] @default([])
  /// false = niet meer in de rotatie (bij een nieuwe versie van het programma weggevallen).
  inRotatie   Boolean  @default(true)

  programma  Programma        @relation(fields: [programmaId], references: [id], onDelete: Cascade)
  oefeningen SchemaOefening[]
  trainingen Training[]

  @@unique([programmaId, code])
}

model SchemaOefening {
  id            String  @id @default(cuid())
  schemaId      String
  oefeningId    String
  volgorde      Int
  aantalSets    Int
  /// Zoveel sets moeten er minstens gelogd zijn voordat de oefening omhoog mag (bij "2–3 sets": 2).
  minSets       Int
  repsMin       Int
  repsMax       Int
  /// Oefeningen met dezelfde letter worden als superset getoond.
  supersetGroep String?
  rustSeconden  Int?
  doelRir       Int?
  cue           String  @default("")

  schema   Schema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  oefening Oefening @relation(fields: [oefeningId], references: [id])

  @@index([schemaId, volgorde])
}

model Training {
  id           String    @id @default(cuid())
  gebruikerId  String
  schemaId     String
  datum        DateTime  @default(now())
  notitie      String    @default("")
  /// bezig | afgerond
  status       String    @default("bezig")
  /// normaal | intro | deload — vastgelegd bij het starten.
  fase         String    @default("normaal")
  /// Week van het programma (1 = eerste week), vastgelegd bij het starten.
  week         Int?
  afgerondOp   DateTime?
  aangemaaktOp DateTime  @default(now())

  gebruiker  Gebruiker          @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  schema     Schema             @relation(fields: [schemaId], references: [id])
  oefeningen TrainingOefening[]

  @@index([gebruikerId, datum])
}

/// Momentopname van het schema bij het starten van een training: een latere schemawijziging
/// herschrijft je geschiedenis niet.
model TrainingOefening {
  id                  String  @id @default(cuid())
  trainingId          String
  oefeningId          String
  volgorde            Int
  aantalSets          Int
  minSets             Int
  repsMin             Int
  repsMax             Int
  supersetGroep       String?
  rustSeconden        Int?
  doelRir             Int?
  cue                 String  @default("")
  /// Gezet als je deze oefening voor een alternatief hebt gewisseld: de oefening uit het schema.
  origineleOefeningId String?

  training Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  oefening Oefening      @relation(fields: [oefeningId], references: [id])
  sets     TrainingSet[]

  @@index([oefeningId])
}

model TrainingSet {
  id                 String   @id @default(cuid())
  trainingOefeningId String
  nummer             Int
  /// null bij lichaamsgewicht
  gewicht            Float?
  reps               Int
  /// 0–4, optioneel
  rir                Int?
  /// 0–10, optioneel. Leeg betekent onbekend, niet 0.
  kniepijn           Int?
  opgeslagenOp       DateTime @default(now()) @updatedAt

  trainingOefening TrainingOefening @relation(fields: [trainingOefeningId], references: [id], onDelete: Cascade)

  @@unique([trainingOefeningId, nummer])
}

model Lichaamsgewicht {
  gebruikerId  String
  datum        DateTime @db.Date
  gewicht      Float
  opgeslagenOp DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}

/// Jouw gegevens voor de berekeningen in het gezondheidsmenu. Eén rij per account.
model Profiel {
  gebruikerId   String    @id
  geboortedatum DateTime? @db.Date
  /// man | vrouw — nodig voor de BMR- en vetpercentageformules.
  geslacht      String?
  lengteCm      Float?
  /// sedentair | licht | matig | zwaar | zeer_zwaar
  activiteit    String    @default("licht")
  /// Leeg: het doel uit het actieve programma.
  doelgewicht   Float?
  /// Gewenst tempo in kg per week; leeg: uit het actieve programma.
  tempoMin      Float?
  tempoMax      Float?
  /// Wanneer je je doelgewicht wilt halen; het personalisatiemenu toetst of dat haalbaar is.
  streefdatum   DateTime? @db.Date
  bijgewerktOp  DateTime  @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
}

/// Wat je in het personalisatiemenu invult. Eén rij per account, net als Profiel.
model Voorkeuren {
  gebruikerId        String   @id
  /// spiermassa | kracht | vetverlies | fit
  doel               String   @default("spiermassa")
  /// beginner | gevorderd | ervaren
  ervaring           String   @default("gevorderd")
  dagenPerWeek       Int      @default(3)
  minutenPerTraining Int      @default(60)
  /// Zie MATERIAAL_KEUZES in generator.ts. Lichaamsgewicht kan altijd.
  materiaal          String[] @default(["dumbbell", "barbell", "trap_bar", "kabel", "machine", "stang"])
  /// knie | schouder | rug
  blessures          String[] @default([])
  /// Bibliotheek-id's.
  favorieten         String[] @default([])
  uitgesloten        String[] @default([])
  /// Spiersleutels die extra aandacht krijgen.
  focus              String[] @default([])
  bijgewerktOp       DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
}

/// Omtrekmaten en (gemeten) vetpercentage, per dag. Gewicht staat in Lichaamsgewicht.
model Lichaamsmeting {
  gebruikerId   String
  datum         DateTime @db.Date
  /// Zelf gemeten (scan, weegschaal); leeg = schatten uit taille en nek.
  vetpercentage Float?
  tailleCm      Float?
  nekCm         Float?
  heupCm        Float?
  armCm         Float?
  borstCm       Float?
  dijCm         Float?
  opgeslagenOp  DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}

/// Herstelcheck vóór de training, schaal 1–5. Geen totaalscore: de signalen staan los.
model Herstelcheck {
  gebruikerId  String
  datum        DateTime @db.Date
  /// 1 = slecht, 5 = top
  slaap        Int
  /// 1 = geen, 5 = veel
  spierpijn    Int
  /// 1 = leeg, 5 = vol energie
  energie      Int
  /// 1 = geen, 5 = veel
  kniepijn     Int
  opgeslagenOp DateTime @default(now()) @updatedAt

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  @@id([gebruikerId, datum])
}
