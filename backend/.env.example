# Kopieer naar backend/.env voor lokale ontwikkeling. Nooit committen.
DATABASE_URL=postgresql://rslnt:rslnt@localhost:5432/rslnt
JWT_SECRET=lokaal-alleen-voor-ontwikkeling
PORT=4200

# Publieke adres voor links in mails (lokaal mag dit weg).
# APP_URL=http://localhost:4200

# Mail via SMTP (Mailgun EU, SendGrid of Resend). Zonder SMTP_HOST worden mails alleen in de
# console gelogd: kopieer daar de bevestigings- of resetlink uit.
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.luzex.nl
# SMTP_WACHTWOORD=
# SMTP_AFZENDER=LuzeX RSLNT <rslnt@mg.luzex.nl>

# Het eigenaarsaccount (admin). Zonder deze waarden: ik@luzex.local / wijzig-dit-meteen
# SEED_EMAIL=
# SEED_WACHTWOORD=
# SEED_NAAM=

# Stripe (Pro-abonnement). Zonder STRIPE_GEHEIME_SLEUTEL geven /api/abonnement/* 503 en blijft
# iedereen op "geen Pro" staan — prima om lokaal zonder te werken. Voor de webhook lokaal:
# stripe listen --forward-to localhost:4200/api/stripe/webhook (geeft een eigen whsec_… terug).
# STRIPE_GEHEIME_SLEUTEL=sk_test_…
# STRIPE_PRIJS_ID=price_…
# STRIPE_WEBHOOK_GEHEIM=whsec_…

# Kruisproduct-Pro: een actief ACCRD- of SCRNN-account geeft gratis Pro. Zonder deze drie doet
# dit product gewoon niet mee. LUZEX_INTERN_SLEUTEL moet letterlijk gelijk zijn aan die van
# ACCRD/SCRNN/CMMNTY.
# LUZEX_INTERN_SLEUTEL=
# ACCRD_INTERN_URL=https://accrd.luzex.nl
# SCRNN_INTERN_URL=
